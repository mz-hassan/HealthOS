    "test:elder:generate": "node scripts/generate-synthetic-elder-corpus.mjs",
    "test:corpus": "node scripts/run-corpus-test.mjs",
    "test:features": "node scripts/run-feature-test.mjs",
    "demo:care": "node scripts/setup-care-demo.mjs"
  },
  "dependencies": {
    "@llamaindex/liteparse": "^2.1.2",
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.1",
    "openai": "^5.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.0.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
